DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5433/disaster_db
# Optional dedicated test database (PostGIS). If unset, pytest still uses
# DATABASE_URL but wraps each test in a SAVEPOINT and rolls back.
# TEST_DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5433/disaster_test

USGS_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson

GDACS_URL=https://www.gdacs.org/gdacsapi/api/events/geteventlist/SEARCH

NDMA_URL=
NDMA_PORTAL_URL=https://sachet.ndma.gov.in/
SACHET_RSS_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml
SACHET_CAP_URL=https://sachet.ndma.gov.in/cap_public_website/FetchXMLFile
SACHET_POLYGON_URL=https://sachet.ndma.gov.in/cap_public_website/FetchPolygonXMLFile

# Optional external service overrides
OVERPASS_URL=
SENTINEL_STAC_URL=
SENTINEL_STAC_COLLECTION=
HTTP_CONNECT_TIMEOUT=
HTTP_READ_TIMEOUT=

# Authentication (JWT)
